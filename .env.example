# KDence environment variables (copy to .env; .env is gitignored).
# All data is local. Do not add anything that causes network egress.

# Where the SQLite datastore lives (Phase 4). Defaults to a per-user data dir if unset.
# KDENCE_DB_PATH=~/.local/share/kdence/kdence.db

# Idle threshold, in seconds, before "active" flips to "idle" (Phase 1).
# KDENCE_IDLE_THRESHOLD_SECONDS=300

# Poll interval, in seconds, for the collector loop (Phase 1/3).
# KDENCE_POLL_INTERVAL_SECONDS=2

# Read-back API bind address/port (Phase 5). Keep bound to localhost.
# KDENCE_API_HOST=127.0.0.1
# KDENCE_API_PORT=8765

# Whether to capture window titles (Phase 2). Titles can leak document names/URLs.
# Default to false (privacy-first); set true only if you want per-title breakdowns.
# KDENCE_CAPTURE_TITLES=false
