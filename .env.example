# KDence configuration. Copy to `.env` (which is gitignored) and edit, then run
# `./install.sh` — it reads this file, generates the systemd user units, aligns the
# browser extension to the ingest port, and (re)starts everything. Re-run it any time
# to restart with new values.
#
# All data is local. Nothing here should cause network egress.

# --- Ports (loopback only) --------------------------------------------------
# Read-back API + dashboard. Open the dashboard at http://127.0.0.1:$KDENCE_API_PORT
KDENCE_API_PORT=5785

# Browser tab-ingest. The WebExtension posts the active tab's hostname here; install.sh
# writes this same port into the extension so the two always match.
KDENCE_INGEST_PORT=5786

# API bind address — keep it loopback.
KDENCE_API_HOST=127.0.0.1

# --- Behaviour --------------------------------------------------------------
# Idle threshold, in seconds, before "active" flips to "idle".
KDENCE_IDLE_THRESHOLD_SECONDS=300

# Capture window titles? Titles can leak document names/URLs, so default off (privacy-first).
# Set to 1/true only if you want per-title detail.
KDENCE_CAPTURE_TITLES=0

# Where the SQLite datastore lives. Unset -> the durable default
# ($XDG_DATA_HOME/kdence/kdence.db, i.e. ~/.local/share/kdence/kdence.db).
# KDENCE_DB_PATH=~/.local/share/kdence/kdence.db
